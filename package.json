{
  "name": "school-app",
  "version": "0.1.0",
  "private": true,
  "description": "Realtime shared PDF annotation MVP for teacher and student",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "test:layout": "node scripts/mobile-layout-browser.mjs && node scripts/student-dashboard-regression.mjs",
    "test:rtc-browser": "node scripts/rtc-browser-e2e.mjs",
    "test:student-ui": "node scripts/student-dashboard-regression.mjs",
    "test:student-screenshots": "node scripts/student-dashboard-screenshots.mjs",
    "test:student-games": "node scripts/student-games-regression.mjs",
    "test:student-interactions": "node scripts/student-game-interactions.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "mongodb": "^6.10.0",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "puppeteer-core": "^24.0.0"
  }
}

{
  "name": "school-app",
  "version": "0.1.0",
  "private": true,
  "description": "Shared PDF lessons, realtime collaboration and student practice",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "test:layout": "node scripts/mobile-layout-browser.mjs && node scripts/student-dashboard-regression.mjs",
    "test:rtc-browser": "node scripts/rtc-browser-e2e.mjs",
    "test:student-ui": "node scripts/student-dashboard-regression.mjs",
    "test:student-screenshots": "node scripts/student-dashboard-screenshots.mjs",
    "test:student-games": "node scripts/student-games-regression.mjs",
    "test:student-interactions": "node scripts/student-game-interactions.mjs",
    "test:student-diagnostic": "node scripts/student-diagnostic-adaptive-e2e.mjs",
    "test:math-adventure": "node scripts/math-adventure-browser.mjs",
    "test:math-hub": "node scripts/math-hub-browser.mjs",
    "test:integration": "node --test --test-concurrency=1 integration/*.integration.cjs",
    "test:pdf": "node scripts/pdf-loading-browser.mjs",
    "test:math-progress": "node scripts/math-progress-browser.mjs",
    "admin:password": "node scripts/admin-password.cjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "mongodb": "^6.10.0",
    "multer": "2.5.0",
    "pdfjs-dist": "6.5.438",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "10.4.3",
    "puppeteer-core": "^24.0.0",
    "socket.io-client": "4.8.3"
  }
}
